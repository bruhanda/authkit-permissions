{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"],
  "exclude": ["tests", "**/*.test.ts", "**/*.test-d.ts", "**/*.test.tsx", "**/*.bench.ts"]
}
