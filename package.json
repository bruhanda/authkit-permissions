{
  "name": "@authkit/permissions",
  "version": "0.1.0",
  "description": "Lightweight, zero-dependency, TypeScript-first RBAC/ABAC for multi-tenant SaaS. <5KB gzipped, runs in Node, Browser, Bun, Deno, Cloudflare Workers and Vercel Edge.",
  "license": "MIT",
  "author": "Vasyl Bruhanda",
  "homepage": "https://github.com/bruhanda/authkit-permissions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruhanda/authkit-permissions.git"
  },
  "bugs": {
    "url": "https://github.com/bruhanda/authkit-permissions/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./adapters/next": {
      "types": "./dist/adapters/next/index.d.ts",
      "import": "./dist/adapters/next/index.js"
    },
    "./adapters/hono": {
      "types": "./dist/adapters/hono/index.d.ts",
      "import": "./dist/adapters/hono/index.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.js"
    },
    "./adapters/fastify": {
      "types": "./dist/adapters/fastify/index.d.ts",
      "import": "./dist/adapters/fastify/index.js"
    },
    "./adapters/nestjs": {
      "types": "./dist/adapters/nestjs/index.d.ts",
      "import": "./dist/adapters/nestjs/index.js"
    },
    "./adapters/trpc": {
      "types": "./dist/adapters/trpc/index.d.ts",
      "import": "./dist/adapters/trpc/index.js"
    },
    "./orm/prisma": {
      "types": "./dist/orm/prisma/index.d.ts",
      "import": "./dist/orm/prisma/index.js"
    },
    "./orm/drizzle": {
      "types": "./dist/orm/drizzle/index.d.ts",
      "import": "./dist/orm/drizzle/index.js"
    },
    "./orm/mongoose": {
      "types": "./dist/orm/mongoose/index.d.ts",
      "import": "./dist/orm/mongoose/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rbac",
    "abac",
    "acl",
    "authorization",
    "permissions",
    "access-control",
    "role-based-access-control",
    "multi-tenant",
    "tenant",
    "typescript",
    "type-safe",
    "policy",
    "edge",
    "cloudflare-workers",
    "vercel-edge",
    "nextjs",
    "hono",
    "trpc",
    "nestjs",
    "fastify",
    "express",
    "react",
    "vue",
    "zero-dependencies",
    "saas"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack .",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run publint && npm run attw && npm run size"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 <12",
    "@prisma/client": ">=5 <7",
    "@trpc/server": ">=11 <13",
    "drizzle-orm": ">=0.30 <1",
    "express": ">=4 <6",
    "fastify": ">=4 <6",
    "hono": ">=4 <5",
    "mongoose": ">=7 <9",
    "next": ">=13.4 <16",
    "react": ">=18 <20",
    "vue": ">=3.4 <4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.16.0",
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.27.0",
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@nestjs/common": "^10.0.0",
    "@prisma/client": "^5.20.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@testing-library/react": "^16.0.0",
    "@trpc/server": "^11.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vue/test-utils": "^2.4.0",
    "drizzle-orm": "^0.36.0",
    "express": "^4.19.0",
    "fastify": "^4.28.0",
    "happy-dom": "^15.11.7",
    "hono": "^4.6.0",
    "mongoose": "^8.7.0",
    "next": "^14.2.0",
    "publint": "^0.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "size-limit": "^11.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "5 KB"
    },
    {
      "name": "errors",
      "path": "dist/errors/index.js",
      "limit": "0.4 KB"
    },
    {
      "name": "audit",
      "path": "dist/audit/index.js",
      "limit": "0.5 KB"
    },
    {
      "name": "builder",
      "path": "dist/builder/index.js",
      "limit": "0.8 KB"
    },
    {
      "name": "adapters/next",
      "path": "dist/adapters/next/index.js",
      "limit": "1 KB"
    },
    {
      "name": "adapters/hono",
      "path": "dist/adapters/hono/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "adapters/express",
      "path": "dist/adapters/express/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "adapters/fastify",
      "path": "dist/adapters/fastify/index.js",
      "limit": "0.7 KB"
    },
    {
      "name": "adapters/nestjs",
      "path": "dist/adapters/nestjs/index.js",
      "limit": "1.5 KB"
    },
    {
      "name": "adapters/trpc",
      "path": "dist/adapters/trpc/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "orm/prisma",
      "path": "dist/orm/prisma/index.js",
      "limit": "0.7 KB"
    },
    {
      "name": "orm/drizzle",
      "path": "dist/orm/drizzle/index.js",
      "limit": "0.7 KB"
    },
    {
      "name": "orm/mongoose",
      "path": "dist/orm/mongoose/index.js",
      "limit": "0.7 KB"
    },
    {
      "name": "react",
      "path": "dist/react/index.js",
      "limit": "1.2 KB"
    },
    {
      "name": "vue",
      "path": "dist/vue/index.js",
      "limit": "1 KB"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
